# Secrets — never commit
# Secrets. Matches .env and EVERY variant (.env.bak, .env.local, .env.2026-11-10...).
# The bare pattern '.env' matches only that exact name: a .env.bak holding a still-live
# API key sat outside it and was committable (caught 2026-11-10 during a key rotation).
.env
.env.*
*.env
credentials.json
token.json

# Environment / caches
.venv/
__pycache__/
*.pyc
.DS_Store

# Copyrighted papers (184 MB). literature/README.md indexes them and IS committed.
literature/*.pdf
*.pdf

# Disposable intermediates
.tmp/
$HOME/
Untitled/

# Logs — regenerated by the daily job, too large and too noisy to version
output/*.log
output/*.backup_*.csv

# Stray downloads that ended up in the project root
*.dmg

# Obsidian per-machine UI state (the vault's notes ARE committed)
.obsidian/workspace.json
.obsidian/plugins/

# Empty Obsidian scratch files (kept on disk, not in the repo).
# NOTE: these are anchored with a leading slash so they match ONLY the vault root.
# Without it, `2026-*.md` also matched notes/2026-*.md at any depth and silently
# kept dated research notes out of the repo while the README linked to them.
/Welcome.md
/Untitled.base
/Untitled.canvas
/Pump math theories and papers.md
/2026-*.md

# Personal drafts that are not part of the research record
notes/*Resume Bullets*

# Obsidian graph layout — per-machine, rewritten on every open
.obsidian/graph.json

# Runtime notify flags written by the launchd jobs (pure triggers, not evidence).
# output/EDGE_CONFIRMED.retracted_2026-11-03.txt is tracked DELIBERATELY: it is
# the record of the retraction, not a live flag.
output/EDGE_FOUND.txt
output/FADE_BEAT.txt
output/FIT_SMG_READY.txt
output/POTENTIAL_EDGE.txt
output/FORWARD_DONE.txt
output/EDGE_DISPROVEN.txt
output/FADE_PROVEN.txt

# Obsidian "Untitled N" variants (the unnumbered ones are listed above; the numbered
# copies slipped past that pattern and one of them, "Untitled 1.canvas", was the single
# stray file actually tracked in the repo).
/Untitled*.canvas
/Untitled*.base
/Untitled*/

# A script once wrote to a literal, unexpanded $HOME and left a directory named "$HOME"
# inside the project. Ignored so a repeat is never committed.
/$HOME/
notes/*Application Summary*
